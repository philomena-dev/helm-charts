{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "philomena chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Empty = image.tag, then the chart's appVersion"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "thirdPartyImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      }
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tcpProbe": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "tcpProbes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "$ref": "#/definitions/tcpProbe"
        },
        "readiness": {
          "$ref": "#/definitions/tcpProbe"
        }
      }
    },
    "httpProbe": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Version of all three Philomena images; empty = the chart's appVersion"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "registryCredentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "extraEnv": {
      "$ref": "#/definitions/envList"
    },
    "siteConfig": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[-._a-zA-Z0-9]+$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "purgeCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string"
        }
      }
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "infisical": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object"
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "$ref": "#/definitions/httpProbe"
        },
        "readiness": {
          "$ref": "#/definitions/httpProbe"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "clientIpHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "events": {
              "type": "integer",
              "minimum": 1
            },
            "window": {
              "type": "string"
            }
          }
        },
        "maxBodySize": {
          "type": "string"
        },
        "downtime": {
          "type": "boolean"
        },
        "cdn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "s3": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bucket": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "region": {
                  "type": "string"
                },
                "usePathStyle": {
                  "type": "boolean"
                },
                "existingSecret": {
                  "type": "string"
                }
              }
            }
          }
        },
        "config": {
          "type": "string"
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "probes": {
          "$ref": "#/definitions/tcpProbes"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ]
        },
        "annotations": {
          "type": "object"
        },
        "loadBalancerIP": {
          "type": "string"
        },
        "loadBalancerClass": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "",
            "Cluster",
            "Local"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "required": [
                    "path"
                  ]
                }
              }
            },
            "required": [
              "host"
            ]
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "mediaproc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "probes": {
          "$ref": "#/definitions/tcpProbes"
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "setupJob": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": [
            "integer",
            "null",
            "string"
          ],
          "description": "Seconds; unset for no deadline"
        },
        "poolSize": {
          "type": "integer",
          "minimum": 1
        },
        "extraEnv": {
          "$ref": "#/definitions/envList"
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "restorePoint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namePrefix": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            },
            "archiveTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "cron": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "concurrencyPolicy": {
          "enum": [
            "Allow",
            "Forbid",
            "Replace"
          ]
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "schedule": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "suspend": {
                "type": "boolean"
              },
              "timeZone": {
                "type": "string"
              },
              "activeDeadlineSeconds": {
                "type": "integer",
                "minimum": 1
              },
              "resources": {
                "$ref": "#/definitions/resources"
              }
            },
            "required": [
              "name",
              "schedule",
              "command"
            ]
          }
        }
      }
    },
    "publicDump": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string"
        },
        "timeZone": {
          "type": "string"
        },
        "suspend": {
          "type": "boolean"
        },
        "namePrefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sourceHost": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "minItems": 1
        },
        "parallelJobs": {
          "type": "integer",
          "minimum": 1
        },
        "workMem": {
          "type": "string"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "siteName": {
              "type": "string",
              "minLength": 1
            },
            "siteUrl": {
              "type": "string",
              "pattern": "^(https?://.+)?$"
            }
          }
        },
        "image": {
          "$ref": "#/definitions/thirdPartyImage"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "scratch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": [
                "string",
                "integer",
                "number"
              ]
            },
            "storageClass": {
              "type": "string"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "shmSize": {
              "type": [
                "string",
                "integer",
                "number"
              ]
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "endpoint": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          }
        },
        "upload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "$ref": "#/definitions/thirdPartyImage"
            },
            "retention": {
              "type": "string"
            },
            "resources": {
              "$ref": "#/definitions/resources"
            }
          }
        },
        "activeDeadlineSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "successfulJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "failedJobsHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "description": "CloudNativePG cluster subchart",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "valkey": {
      "type": "object",
      "description": "Valkey subchart",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "externalValkey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        }
      }
    },
    "opensearch": {
      "type": "object",
      "description": "OpenSearch subchart",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "masterService": {
          "type": "string"
        }
      }
    },
    "externalOpensearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "externalMediaproc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addr": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "extraFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
