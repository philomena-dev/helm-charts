# Environment of the Philomena app, as an env file for
#
#   kubectl -n philomena create secret generic philomena-env --from-env-file=philomena.env
#
# Based on docker/production/.env-example of Philomena 1.3. Left out on
# purpose: PORT, APP_IP, DATABASE_URL, PG*, REDIS_HOST, OPENSEARCH_URL and
# MEDIAPROC_ADDR (the chart sets them), MIX_ENV (breaks release migrations)
# and RELEASE_NODE (set by the image's scripts).
#
# No quotes around values, no spaces around "=": kubectl takes each line
# literally.

# --- Secrets. Generate each with: openssl rand -hex 64
# Keep a copy somewhere safe and never change them: sessions, password
# hashes and two-factor enrolments depend on them.
SECRET_KEY_BASE=
PASSWORD_PEPPER=
OTP_SECRET_KEY=
ANONYMOUS_NAME_SALT=

# --- First administrator, created when the database is set up for the first
# time (ignored afterwards; remove the password once you have logged in and
# changed it). The password is checked against known breaches and the setup
# fails if it is a common one, including upstream's default.
ADMIN_USERNAME=Administrator
ADMIN_EMAIL=admin@philomena.example
ADMIN_PASSWORD=

# --- Site
# Public URL of the site, and every host name it answers on
APP_ORIGIN=https://philomena.example
SITE_DOMAINS=philomena.example,www.philomena.example

# --- CDN domain: where browsers load uploaded files from
CDN_HOST=cdn.philomena.example
IMAGE_URL_ROOT=https://cdn.philomena.example/img
AVATAR_URL_ROOT=https://cdn.philomena.example/avatars
ADVERT_URL_ROOT=https://cdn.philomena.example/spns
BADGE_URL_ROOT=https://cdn.philomena.example/badges
TAG_URL_ROOT=https://cdn.philomena.example/tags

# --- Object storage for uploaded files (any S3-compatible service)
S3_SCHEME=https
S3_HOST=
S3_PORT=443
S3_REGION=auto
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Key prefixes inside the bucket
IMAGE_FILE_ROOT=images
AVATAR_FILE_ROOT=avatars
ADVERT_FILE_ROOT=adverts
BADGE_FILE_ROOT=badges
TAG_FILE_ROOT=tags

# Optional second (backup) bucket
#ALT_S3_SCHEME=https
#ALT_S3_HOST=
#ALT_S3_PORT=443
#ALT_S3_REGION=
#ALT_S3_BUCKET=
#ALT_AWS_ACCESS_KEY_ID=
#ALT_AWS_SECRET_ACCESS_KEY=

# --- Outgoing mail
SMTP_RELAY=
#SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_ADDRESS=noreply@philomena.example

# --- hCaptcha (https://www.hcaptcha.com)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# --- Scrapers. The variable has to exist; any value will do when you have
# no Tumblr API key.
TUMBLR_API_KEY=unset

# --- Optional
# Image proxy (go-camo) for externally hosted images in comments and posts
#CAMO_HOST=camo.philomena.example
#CAMO_KEY=
# HTTP proxy for the requests the scrapers make
#PROXY_HOST=http://tinyproxy:3128
# Database connections per app, worker and cron pod (default 16)
#POOL_SIZE=20
# Hide the version in the footer
#HIDE_VERSION=true
